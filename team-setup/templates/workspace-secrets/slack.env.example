# Copy to ~/.config/<workspace>/slack.env (chmod 600).
# These are *shared* team operator secrets — same values for every engineer.
# Prefer materializing via 1Password (see op/slack.env.tpl) instead of chat/email.
#
# Never commit the real file. Never paste tokens into git, PRs, or issues.

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Bret’s sandbox verify check-off is a thread per drop in #comita-support,
# not a Slack List (Lists needs a paid plan). The bot needs chat:write,
# channels:history, channels:read and reactions:read. Mirror the channel id
# as a GitHub Actions *variable* on comita_admissions (bot token stays
# secrets.SLACK_BOT_TOKEN). Do not poll from a laptop.
#
# Optional. Publish @channel target (default #comita-support).
# COMITA_VERIFY_NOTIFY_CHANNEL_ID=#comita-support
# Optional. Team id for building Slack permalinks (auth.test if unset).
# COMITA_SLACK_TEAM_ID=
