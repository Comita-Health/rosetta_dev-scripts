# Copy to ~/.config/<workspace>/slack.env (chmod 600).
# These are *shared* team operator secrets — same values for every engineer.
# Prefer materializing via 1Password (see op/slack.env.tpl) instead of chat/email.
#
# Never commit the real file. Never paste tokens into git, PRs, or issues.

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Slack List id for Bret’s Sandbox verify check-off (not a secret).
# Create the list once (columns: Item, Host, Status, Ship, Notes).
# Id is the F… segment in the list URL. Not the Feedback tracker.
COMITA_VERIFY_SLACK_LIST_ID=
# Optional column id overrides if the list schema does not use those names:
# COMITA_VERIFY_COL_ITEM=Item
# COMITA_VERIFY_COL_HOST=Host
# COMITA_VERIFY_COL_STATUS=Status
# COMITA_VERIFY_COL_SHIP=Ship
# COMITA_VERIFY_COL_NOTES=Notes
