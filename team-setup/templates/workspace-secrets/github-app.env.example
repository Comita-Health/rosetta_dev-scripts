# Copy to ~/.config/<workspace>/github-app.env (chmod 600).
# Fill from your *private* GitHub App (or the org shared App if your team
# standardizes on one bot). Never commit the real file.
#
# Create App: https://github.com/settings/apps/new (or org Settings →
# Developer settings → GitHub Apps). Install it on the org repos you need.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
# Bot slug without [bot] — e.g. addi-m, rosetta-s-addi-m, or your-bot-name
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=$HOME/.config/__WORKSPACE__/github-app.pem

# DCO / commit identity for the App (must match the bot noreply email pattern)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
